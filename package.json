{
  "name": "permaplanner",
  "version": "0.41.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/ensure-postgres.sh && op run --env-file=.env.1password -- run-p dev:server dev:client",
    "dev:plain": "bash scripts/ensure-postgres.sh && run-p dev:server dev:client",
    "dev:server": "mix phx.server",
    "dev:client": "vite",
    "dev:e2e:server": "MIX_ENV=test PHX_SERVER=true PORT=4002 mix phx.server",
    "dev:e2e:client": "PHOENIX_DEV_URL=http://127.0.0.1:4002 vite --port 5173 --strictPort",
    "e2e:serve": "bash scripts/e2e-serve.sh",
    "gen:env:1password": "node scripts/gen-env-1password.mjs",
    "deploy:fly": "bash scripts/fly-deploy-op.sh",
    "install:toolchain": "bash scripts/install-toolchain.sh",
    "start": "rm -rf priv/static && cp -r dist priv/static && MIX_ENV=prod mix phx.server",
    "start:server:test": "mix test",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "run-p dev:server preview:client",
    "preview:client": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "PLAYWRIGHT_HTML_OPEN=always playwright test --reporter=html",
    "test:e2e:report:open": "playwright show-report",
    "build-only": "vite build",
    "type-check": "vue-tsc --project tsconfig.app.json",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "bundle:migration:v8": "esbuild scripts/migrate-guild-boundaries-v8.ts --banner:js='// Frozen v8 migration bundle; regenerate only before release with npm run bundle:migration:v8.' --bundle --platform=node --target=node22 --format=cjs --minify --legal-comments=eof --outfile=priv/repo/support/guild-boundaries-v8.cjs && prettier --write priv/repo/support/guild-boundaries-v8.cjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@turf/polygon-smooth": "^7.4.0",
    "@vueuse/core": "^15.1.0",
    "flatbush": "^4.8.0",
    "fuse.js": "^7.5.0",
    "motion-v": "^2.13.0",
    "pinia": "^4.1.0",
    "polygon-clipping": "^0.15.7",
    "simplify-js": "^1.2.4",
    "uuid": "^14.0.3",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "2.0.1",
    "@eslint/js": "^10.0.1",
    "@flydotio/dockerfile": "0.7.15",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.11",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/ui": "^5.1.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.1.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@codecov/bundler-plugin-core": {
      "zod": "^4.6.7"
    },
    "js-beautify": {
      "glob": "^14.0.6",
      "editorconfig": "^4.0.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
